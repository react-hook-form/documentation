{
  "name": "react-hook-form-website",
  "description": "React hooks for form validation without the hassle.",
  "version": "6.0.1",
  "type": "module",
  "author": "beier luo",
  "dependencies": {
    "@hookform/devtools": "4.4.0",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@qino/cms": "0.17.0",
    "class-variance-authority": "^0.6.1",
    "clsx": "^1.2.1",
    "little-state-machine": "^4.8.1",
    "next": "16.4.2",
    "next-themes": "^0.2.1",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-flip-numbers": "^3.0.9",
    "react-hook-form": "8.0.0-beta.4",
    "react-simple-animate": "^3.5.3",
    "react-sortablejs": "1.5.1",
    "rehype-mdx-code-props": "^3.0.1",
    "remark-custom-heading-id": "^2.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "sortablejs": "1.15.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.2",
    "@types/eslint-plugin-jsx-a11y": "6.10.0",
    "@types/eslint__eslintrc": "2.1.2",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-helmet": "^6.1.11",
    "cross-env": "^7.0.3",
    "eslint": "9.17.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "keywords": [
    "react-hook-form",
    "form-validation"
  ],
  "license": "MIT",
  "scripts": {
    "analyze": "qino build && cross-env ANALYZE=true next build --webpack",
    "build": "qino build && pnpm run markdown && next build",
    "dev": "qino build && pnpm run markdown && next dev",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "markdown": "tsx scripts/generate-markdown.mts",
    "seo:check": "pnpm run build && node scripts/check-seo.mjs",
    "lint:ci": "qino lint && next typegen && eslint src",
    "now-build": "pnpm run build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "next typegen && tsc --noEmit",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{ts,tsx,mdx,css,json}": [
      "pnpm run format:fix"
    ]
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    }
  }
}
